<mxfile host="app.diagrams.net" modified="2026-03-11" agent="Claude">
  <diagram id="compression-compare" name="CSV vs Parquet Compression">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="450" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- CSV Section -->
        <mxCell id="csv-title" value="CSV (Row-based compression)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#D32F2F;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="280" height="25" as="geometry"/>
        </mxCell>

        <!-- CSV Row Container -->
        <mxCell id="csv-box" value="" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#D32F2F;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="760" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="csv-content" value="1,Alice,Eng,95000,2023 │ 2,Bob,Mkt,75000,2022 │ 3,Carol,Eng,105000,2021 │ ..." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#D32F2F;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="50" y="70" width="740" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="csv-label" value="← mixed types: int, str, str, int, date, int, str, str, int, date..." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="115" width="400" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="csv-result" value="Compression finds few patterns → 2-4x ratio" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#D32F2F;fontColor=#B71C1C;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="112" width="270" height="26" as="geometry"/>
        </mxCell>

        <!-- Parquet Section -->
        <mxCell id="parquet-title" value="Parquet (Column-based compression)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#1976D2;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="300" height="25" as="geometry"/>
        </mxCell>

        <!-- Parquet Columns -->
        <mxCell id="col1" value="1,2,3...&#xa;(ints)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=2;fontColor=#1565C0;fontSize=11;fontStyle=1;" vertex="1" parent="1">
