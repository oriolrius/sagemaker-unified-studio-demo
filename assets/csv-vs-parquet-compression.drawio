        <mxCell id="col2" value="Alice,Bob...&#xa;(strings)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;strokeWidth=2;fontColor=#2E7D32;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="195" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="col3" value="Eng,Mkt,Eng&#xa;(dict+RLE)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#F57C00;strokeWidth=2;fontColor=#E65100;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="195" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="col4" value="95k,75k...&#xa;(deltas)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C2185B;strokeWidth=2;fontColor=#AD1457;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="195" width="130" height="60" as="geometry"/>
