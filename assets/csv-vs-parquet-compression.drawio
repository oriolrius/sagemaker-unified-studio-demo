        <mxCell id="compare-text" value="Parquet achieves 5-10x better compression than CSV&#xa;by grouping same-type data together before applying compression algorithms" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#424242;fontStyle=1;" vertex="1" parent="1">
