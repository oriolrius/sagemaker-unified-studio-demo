        <mxCell id="compare-box" value="" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="365" width="600" height="55" as="geometry"/>
