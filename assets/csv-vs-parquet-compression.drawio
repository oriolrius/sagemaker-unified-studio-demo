        <mxCell id="col5" value="2023,2022...&#xa;(deltas)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#7B1FA2;strokeWidth=2;fontColor=#6A1B9A;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="690" y="195" width="120" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="parquet-label" value="Each column compresses independently with type-specific encoding" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="265" width="400" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="parquet-result" value="Same-type clustering → 10-20x ratio" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1976D2;fontColor=#0D47A1;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="262" width="270" height="26" as="geometry"/>
